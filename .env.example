# Environment variables configuration for DineMind AI
# Official Mappls (MapmyIndia) Web SDK v3.0 Key
# Get your Mappls API key from: https://about.mappls.com/api/
# Note: If key is omitted or returns HTTP 401 Unauthorized, system automatically uses Leaflet + OpenStreetMap engine fallback.
MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY
VITE_MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY
